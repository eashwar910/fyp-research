{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/data_verification.schema.json",
  "title": "Stage 4b data verifier output",
  "type": "object",
  "required": ["id", "verdict", "sources", "ground_truth", "compute_path", "queries", "fetched"],
  "properties": {
    "id": { "type": "string" },
    "verdict": { "type": "string", "enum": ["open", "conditional", "blocked"] },
    "verdict_reason": { "type": "string", "maxLength": 400 },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "url", "fetched_ok", "licence_class", "access_mode", "covers_target_region"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["imagery", "labels", "auxiliary", "comparator"] },
          "url": { "type": "string" },
          "fetched_ok": { "type": "boolean" },
          "licence_quote": { "type": "string", "maxLength": 200 },
          "licence_class": { "type": "string", "enum": ["open", "non_commercial", "academic_program", "registration", "paid", "unknown"] },
          "access_mode": { "type": "string", "enum": ["gee_catalog", "planetary_computer", "direct_download", "api", "application_required", "unverified"] },
          "platform_id": { "type": "string", "description": "GEE asset id / PC collection / Kaggle slug, if any" },
          "size_gb": { "type": ["number", "null"] },
          "coverage_quote": { "type": "string", "maxLength": 200 },
          "covers_target_region": { "type": "string", "enum": ["true", "false", "partial"] },
          "date_range": { "type": "string" },
          "caveats_quoted": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
          "nicfi_purpose_check": { "type": ["string", "null"], "enum": ["inside", "outside", "borderline", null] },
          "sg_farmland_terms_ok": { "type": ["boolean", "null"] },
          "application_deadline": { "type": ["string", "null"] }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["shipped", "external_named", "must_construct", "none"] },
        "source_url": { "type": ["string", "null"] },
        "construction_protocol": { "type": ["string", "null"], "maxLength": 300 },
        "label_count_estimate": { "type": ["string", "null"] }
      }
    },
    "compute_path": {
      "type": "object",
      "required": ["platform", "fits_C9", "why"],
      "properties": {
        "platform": { "type": "string" },
        "fits_C9": { "type": "boolean" },
        "why": { "type": "string", "maxLength": 200 },
        "gpu_hours_per_week_estimate": { "type": ["number", "null"] }
      }
    },
    "queries": { "$ref": "_common.schema.json#/$defs/query_log" },
    "fetched": { "type": "array", "items": { "type": "string" } },
    "budget_exhausted": { "type": "boolean" },
    "notes": { "type": "string", "maxLength": 500 }
  }
}
