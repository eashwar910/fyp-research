{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/_common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "url_evidence": {
      "type": "object",
      "required": [
        "url",
        "date",
        "tier"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "title": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "region": {
      "type": "string",
      "enum": [
        "india",
        "eu",
        "singapore",
        "singapore_source_basket",
        "malaysia",
        "global"
      ]
    },
    "bucket": {
      "type": "string",
      "enum": [
        "satellite",
        "drone_and_aerial",
        "standout"
      ]
    },
    "query_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "q",
          "useful"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "useful": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        },
        "partial": {}
      }
    }
  }
}